# Copy to .env (gitignored) and fill in. Values stay on the host: the harness never puts
# them in the repo, the event log or a sandbox.

# Apify API token (console.apify.com → Settings → API & Integrations).
# Used by `study` for web search, and by capabilities through the egress gateway when
# the run is started with FRANK_SECRETS=APIFY_TOKEN.
APIFY_TOKEN=
